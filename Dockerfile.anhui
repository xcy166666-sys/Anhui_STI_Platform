FROM node:20-alpine AS frontend-builder

WORKDIR /frontend

COPY rag_frontend/package*.json ./
RUN npm ci

COPY rag_frontend/ ./
RUN npm run build

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i \
          -e 's|http://deb.debian.org/debian|https://mirrors.aliyun.com/debian|g' \
          -e 's|http://deb.debian.org/debian-security|https://mirrors.aliyun.com/debian-security|g' \
          -e 's|http://security.debian.org/debian-security|https://mirrors.aliyun.com/debian-security|g' \
          /etc/apt/sources.list.d/debian.sources; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY mewhelp_backend/requirements-anhui.txt /tmp/requirements-anhui.txt
RUN pip install --no-cache-dir \
    --index-url https://mirrors.aliyun.com/pypi/simple/ \
    --retries 5 \
    --timeout 60 \
    -r /tmp/requirements-anhui.txt

COPY mewhelp_backend /app/mewhelp_backend
COPY --from=frontend-builder /frontend/dist /app/anhui_frontend
RUN mkdir -p /app/anhui_data/cleaned

WORKDIR /app/mewhelp_backend

EXPOSE 8010

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8010/healthz || exit 1

CMD ["uvicorn", "app.anhui_main:app", "--app-dir", ".", "--host", "0.0.0.0", "--port", "8010"]
