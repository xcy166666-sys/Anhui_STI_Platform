FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY rag_backend/requirements-anhui.txt /tmp/requirements-anhui.txt
RUN pip install --no-cache-dir -r /tmp/requirements-anhui.txt

COPY rag_backend /app/rag_backend
COPY anhui_frontend /app/anhui_frontend
RUN mkdir -p /app/anhui_data/cleaned

WORKDIR /app/rag_backend

EXPOSE 8010

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8010/healthz || exit 1

CMD ["uvicorn", "app.anhui_demo:app", "--app-dir", ".", "--host", "0.0.0.0", "--port", "8010"]
